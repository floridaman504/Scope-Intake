# Copy this file to .env for local development (vite dev reads .env automatically).
# Never commit the real .env file -- it's covered by .gitignore.
# Production values live in Vercel Project Settings -> Environment Variables, not here.

# Supabase project URL (Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key (Settings -> API -> anon public key)
# Safe to expose in the browser -- RLS policies, not this key, control access.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (used by api/review-job.js on Vercel, never sent to the browser).
# Set this in Vercel's dashboard for Production/Preview, not in a client .env you'd commit.
ANTHROPIC_API_KEY=sk-ant-your-key-here
